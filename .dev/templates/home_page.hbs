    <section id="tl-home--contact">
        <div class="govuk-width-container govuk-main-wrapper">
            <div class="govuk-grid-row tl-row-fill">


                <div class="govuk-grid-column-one-half tl-row-fill">
                    <div class="tl-card--black">
                        <h3 class="govuk-heading-m">Have a T Levels question?</h3>
                        <p class="govuk-body">
                            Our T Levels support bot is here to help you find the answers.
                        </p>
                        <p class="govuk-body govuk-!-margin-bottom-0">
                            <a href="#" id="tl-home--answerbot" class="govuk-link">Ask a question</a>

                        </p>

                    </div>
                </div>

                <div class="govuk-grid-column-one-half tl-row-fill">
                    <div class="tl-card--black tl-js-hidden" id="tl-home--ticket">
                        <h3 class="govuk-heading-m">Contact us</h3>
                        <p class="govuk-body">
                            If you'd like to speak to someone about T Levels, contact us and we'll get back to you within 2 days.
                        </p>
                        <p class="govuk-body govuk-!-margin-bottom-0">
                            {{#link 'new_request' class='govuk-link tl-home--contact govuk-!-margin-bottom-0' }}
                            Send a message
                            {{/link}}
                        </p>

                    </div>
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        if (!isAgent()) {
                            $("#tl-home--ticket").show();
                        }
                    });
                </script>
            </div>


        </div>
    </section>
</main>

<script>
  document.addEventListener('DOMContentLoaded', function() {
  	frontDoor('{{settings.tl_calendar_api_key}}', '{{settings.tl_calendar_data_source}}');
  });

    $('#tl-home--answerbot').click(function () {
    openHelp();
    event.preventDefault();
});
</script>

{{#if settings.answerbot_enabled}}
<script id="ze-snippet" src="https://static.zdassets.com/ekr/snippet.js?key={{settings.answerbot_key}}"></script>
<script type="text/javascript">
    window.zESettings = {
        webWidget: {
            answerBot: {
                avatar: {
                    url: "{{settings.answerbot_icon}}",
                    name: {
                        "*": '{{settings.answerbot_name}}'
                    }
                },
                title: {
                    "en-gb": "T Levels support for schools and colleges"
                },
                search: {
                    labels:
                        ['answerbot']
                },
                contactOnlyAfterQuery: true
            }
        }
    };
</script>
{{/if}}

<script>
    if ($('.tl-home--panel--events--events').children().length == 0) {
        $('.tl-home--panel--events--events').html('<div class="govuk-grid-column-full"><p class="govuk-body">There are no upcoming T Level events at the moment.</p></div>')
        $('.tl-home--panel--events--all').hide();
    }

    if ($('.tl-home--panel--keydates--keydates').children().length == 0) {
        $('.tl-home--panel--keydates--keydates').html('<p class="govuk-body">There are no upcoming T Level key dates or deadlines.</p>')
        $('.tl-home--panel--keydates--all').hide();
    }
</script>
