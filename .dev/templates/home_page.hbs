    <section id="tl-home--more">
        <div class="govuk-width-container govuk-!-margin-top-7">
            <div class="govuk-grid-row">


                <!-- More information -->
                <div class="govuk-grid-column-full">
                    <h2 class="govuk-heading-m tl-heading--bar">More about T Levels</h2>
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-one-half tl-row-fill">


                            <div class="govuk-grid-row tl-row-fill">
                                <div class="tl-column--half">
                                    <img class="tl-image--cover tl-home--banner--column--image" src="{{settings.home_image_5}}" />
                                </div>
                                {{#each categories}}
                                {{#is name "Case studies"}}
                                <div class="tl-column--half tl-flex--column">
                                    <h4 class="govuk-heading-s">{{name}}</h4>
                                    <p class="govuk-body-s">{{excerpt description}}</p>
                                    <p class="govuk-body govuk-!-margin-bottom-0"><a href="{{url}}" class="govuk-link" GTMname="{{name}}">See T Level case studies</a></p>
                                </div>
                                {{/is}}
                                {{/each}}
                            </div>


                        </div>
                        <div class="govuk-grid-column-one-half">

                            <div class="govuk-grid-row tl-row-fill">
                                <div class="tl-column--half">
                                    <img class="tl-image--cover tl-home--banner--column--image" src="{{settings.home_image_6}}" />
                                </div>
                                {{#each categories}}
                                {{#is name "Foundation Year"}}
                                <div class="tl-column--half tl-flex--column">
                                    <h4 class="govuk-heading-s">{{name}}</h4>
                                    <p class="govuk-body-s">{{excerpt description}}</p>
                                    <p class="govuk-body govuk-!-margin-bottom-0"><a href="{{url}}" class="govuk-link" GTMname="{{name}}">Discover the programme</a></p>
