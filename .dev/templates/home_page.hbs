                    </div>
                    <div class="govuk-grid-row tl-row-fill tl-home--panel--events--all">

                        <div class="govuk-grid-column-full">
                            <hr class="govuk-section-break tl-section-break govuk-!-margin-bottom-3 govuk-section-break--m govuk-section-break--visible tl-flex--grow">
                            <p class="govuk-body tl-text--right govuk-!-margin-bottom-0"><a id="tl-home-events--all" href="{{url}}" class="govuk-link govuk-link--no-visited-state">All events</a></p>
                        </div>

