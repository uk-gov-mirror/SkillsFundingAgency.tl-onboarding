                    <div class="govuk-grid-row tl-row-fill tl-home--panel--events--events">

                        {{#each categories}}
                        {{#is name "T Level events"}}

                        {{#each sections}}
                        {{#is name "T Level events"}}
                        {{#each articles}}
                        {{#is @index 0}}

                        <div class="govuk-grid-column-one-third tl-row-fill">
                            <div class="tl-home--events--card tl-flex--column">
                                <h3 class="govuk-heading-s govuk-!-margin-bottom-0 tl-flex--grow"><a class="govuk-link tl-home-events--article" href="{{url}}">{{title}}</a></h3>
                                <p class="govuk-body govuk-!-margin-top-1 govuk-!-font-weight-bold govuk-!-margin-bottom-0 tl-home-keydates--date" id="tl-article--date--{{id}}"></p>
                                <script>
                                $.getJSON('/api/v2/help_center/articles/{{id}}', function (articlelabels) {

                                    if (articlelabels.article.label_names && articlelabels.article.label_names.length) {
                                        articlelabels.article.label_names.forEach(function (labelname) {

                                            if (labelname.indexOf("date") != -1) {
                                                var date = labelname.split('/')[1];
