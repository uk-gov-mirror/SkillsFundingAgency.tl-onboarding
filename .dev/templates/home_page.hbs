<script type="text/javascript">
    if (window.location.href.indexOf("eturn_to=%2Fhc%2Frequests") > -1) {
        window.location.href = "/hc/en-gb/articles/{{settings.article_id_confirmation}}";
    }

    $(".tl-phase-banner").addClass("tl-phase-banner--home");
</script>

<!-- Main content -->
<main id="main-content" role="main">
    <!-- Banner -->
    <section id="tl-home--banner">
        <div class="govuk-width-container govuk-main-wrapper">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full">
                    <div class="tl-home--banner">
                        <div class="tl-home--banner--column">
                            <div class="tl-home--banner--card govuk-!-padding-8">
                                <h1 class="govuk-heading-l govuk-!-margin-bottom-5 govuk-!-margin-top-0">{{settings.homepage_banner_title}}</h1>
                                <p class="govuk-body">{{settings.homepage_banner_text}}</p>
                                <p class="govuk-body govuk-!-margin-bottom-0"><a class="govuk-button govuk-!-margin-bottom-0" id="tl-home-banner--cta" href="/hc/en-gb/sections/{{settings.homepage_banner_section}}">{{settings.homepage_banner_button}}</a></p>
                            </div>
                        </div>
                        <div class="tl-home--banner--column">
                            <img class="tl-image--cover tl-home--banner--column--image" src="{{settings.homepage_banner_image}}" />
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </section>

    <section id="tl-home--news">
        <!-- NEWS -->
        <div class="govuk-width-container">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full">
                    <h2 class="govuk-heading-m tl-heading--bar">Featured news</h2>
                    <div class="govuk-grid-row tl-row-fill">
                        <div class="govuk-grid-column-one-half">
                            <img class="tl-image--cover tl-home--banner--column--image" src="{{settings.homepage_news_image}}" />
                        </div>
                        <div class="govuk-grid-column-one-half tl-flex--column">
                            {{#each categories}}
                            {{#is name "T Level news"}}
                            {{#each sections}}
                            {{#is name "Featured news"}}
                            {{#each articles}}
                            {{#if @first}}
                            <span class="govuk-caption-m govuk-!-font-size-16">{{date updated_at class='metadata' format='medium'}}</span>
                            <h4 class="govuk-heading-m govuk-!-margin-top-2"><a id="tl-home-news--article" class="govuk-link govuk-link--no-visited-state" href="{{url}}">{{title}}</a></h4>
                            <p class="govuk-body">{{excerpt body characters=200}}</p>
                            {{/if}}
                            {{/each}}
                            {{/is}}
                            {{/each}}
                            <hr class="govuk-section-break tl-section-break govuk-!-margin-bottom-3 govuk-section-break--m govuk-section-break--visible tl-flex--grow">
                            <p class="govuk-body tl-text--right govuk-!-margin-bottom-0"><a id="tl-home-news--all" href="{{url}}" class="govuk-link govuk-link--no-visited-state">All T Level news</a></p>
                            {{/is}}
                            {{/each}}
                        </div>
                    </div>
                </div>


            </div>
            <!-- NEWSLETTER -->
            <div class="govuk-grid-row govuk-!-margin-top-7 govuk-!-margin-bottom-6">
                <div class="govuk-grid-column-full">
                    <h2 class="govuk-heading-m tl-heading--bar">Key dates and deadlines</h2>

                    <div class="govuk-grid-row tl-row-fill">
                        <!-- KEY DATES -->
                        <div class="govuk-grid-column-two-thirds-from-desktop">
                            <div class="tl-home--panel--keydates--keydates">

                                {{#each categories}}
                                {{#is name "T Level events"}}
                                {{#each sections}}
                                {{#is name "Key dates and deadlines"}}

                                {{#each articles}}

                                {{#is @index 0}}
                                <div class="tl-home-keydates govuk-!-margin-top-1">
                                    <p class="govuk-heading-s govuk-!-margin-bottom-0 tl-home-keydates--date" id="tl-article--date--{{id}}"></p>
                                    <h3 class="govuk-heading-s govuk-!-margin-bottom-0 tl-home-keydates--title">
                                        <a class="govuk-link tl-home-keydates--article" href="{{url}}">{{title}}</a>
                                    </h3>
                                    <script>
                                                    $.getJSON('/api/v2/help_center/articles/{{id}}', function (articlelabels) {
                                                        if (articlelabels.article.label_names && articlelabels.article.label_names.length) {
                                                            articlelabels.article.label_names.forEach(function (labelname) {
                                                                if (labelname.indexOf("date") != -1) {
                                                                    var date = labelname.split('/')[1];
                                                                    var dateformatted = moment(date).format("D MMM");
                                                                    $("#tl-article--date--{{id}}").text(dateformatted);
                                                                }
                                                            });
                                                        }
                                                    });
                                    </script>
                                </div>
                                <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
                                {{/is}}

                                {{#is @index 1}}
                                <div class="tl-home-keydates">
                                    <p class="govuk-heading-s govuk-!-margin-bottom-0 tl-home-keydates--date" id="tl-article--date--{{id}}"></p>
                                    <h3 class="govuk-heading-s govuk-!-margin-bottom-0 tl-home-keydates--title">
                                        <a class="govuk-link tl-home-keydates--article" href="{{url}}">{{title}}</a>
                                    </h3>
                                    <script>
                                                    $.getJSON('/api/v2/help_center/articles/{{id}}', function (articlelabels) {
                                                        if (articlelabels.article.label_names && articlelabels.article.label_names.length) {
                                                            articlelabels.article.label_names.forEach(function (labelname) {
                                                                if (labelname.indexOf("date") != -1) {
                                                                    var date = labelname.split('/')[1];
                                                                    var dateformatted = moment(date).format("D MMM");
                                                                    $("#tl-article--date--{{id}}").text(dateformatted);
                                                                }
                                                            });
                                                        }
                                                    });
                                    </script>
                                </div>
                                <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
                                {{/is}}

                                {{#is @index 2}}
                                <div class="tl-home-keydates">
                                    <p class="govuk-heading-s govuk-!-margin-bottom-0 tl-home-keydates--date" id="tl-article--date--{{id}}"></p>
                                    <h3 class="govuk-heading-s govuk-!-margin-bottom-0 tl-home-keydates--title">
                                        <a class="govuk-link tl-home-keydates--article" href="{{url}}">{{title}}</a>
                                    </h3>
                                    <script>
                                                    $.getJSON('/api/v2/help_center/articles/{{id}}', function (articlelabels) {
                                                        if (articlelabels.article.label_names && articlelabels.article.label_names.length) {
                                                            articlelabels.article.label_names.forEach(function (labelname) {
                                                                if (labelname.indexOf("date") != -1) {
                                                                    var date = labelname.split('/')[1];
                                                                    var dateformatted = moment(date).format("D MMM");
                                                                    $("#tl-article--date--{{id}}").text(dateformatted);
                                                                }
                                                            });
                                                        }
                                                    });
                                    </script>
                                </div>
                                {{/is}}
                                {{/each}}
                            </div>

                            <div class="tl-home--panel--keydates--all">
                                <hr class="govuk-section-break tl-section-break govuk-!-margin-bottom-3 govuk-section-break--m govuk-section-break--visible tl-flex--grow">
                                <p class="govuk-body tl-text--right govuk-!-margin-bottom-0">
                                    <a id="tl-home-keydates--all" href="{{url}}" class="govuk-link govuk-link--no-visited-state">All key dates</a>
                                </p>
                            </div>

                            {{/is}}
                            {{/each}}
                            {{/is}}
                            {{/each}}

                        </div>

                        <!-- IMAGE -->
                        <div class="govuk-grid-column-one-third-from-desktop">
                            <img class="tl-image--cover tl-home--banner--column--image" src="{{settings.homepage_key_dates_image}}" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="tl-home--findemployers">
        <div class="govuk-width-container govuk-!-margin-bottom-6">
            <h2 class="govuk-heading-m tl-heading--bar">Find employers and help them find you</h2>

            <div class="govuk-grid-row tl-row-fill">
                <div class="govuk-grid-column-one-half tl-row-fill govuk-!-margin-top-3">
                    <div class="govuk-grid-row tl-row-fill">
                        <div class="tl-column--half">
                            <img class="tl-image--cover tl-home--banner--column--image" src="{{settings.homepage_employers_image1}}" />
                        </div>
                        <div class="tl-column--half tl-flex--column">
                            <h4 class="govuk-heading-s">Connect with employers</h4>
                            <p class="govuk-body-s">Use our new service to find employers who have expressed an interest in T Levels and industry placements.</p>
                            <p class="govuk-body govuk-!-margin-bottom-0"><a class="govuk-link" href="{{settings.connect_link}}">Find employers near you</a></p>
                        </div>
                    </div>
                </div>
                <div class="govuk-grid-column-one-half tl-row-fill govuk-!-margin-top-3">
                    <div class="govuk-grid-row tl-row-fill">
                        <div class="tl-column--half">
                            <img class="tl-image--cover tl-home--banner--column--image" src="{{settings.homepage_employers_image2}}" />
                        </div>
                        <div class="tl-column--half tl-flex--column">
                            <h4 class="govuk-heading-s">Are your T Level details up to date?</h4>
                            <p class="govuk-body-s">Make sure your organisation and course details are up to date so students and employers can find your T Level courses.</p>
                            <p class="govuk-body govuk-!-margin-bottom-0"><a class="govuk-link" href="/hc/en-gb/articles/{{settings.article_id_updatedetails}}">Update your details</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="tl-home--information">
        <div class="govuk-width-container">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full">
                    <h2 class="govuk-heading-m tl-heading--bar">Information and guidance</h2>

                    <div class="tl-home--categories">

                        {{#each categories}}
                        {{#is name "How this site works"}}
                        {{else}}
                        {{#is name "T Level news"}}
                        {{else}}
                        {{#is name "T Level events"}}
                        {{else}}
                        {{#is name "How to deliver T Levels"}}
                        {{else}}
                        {{#is name "T Level Foundation Year"}}
                        {{else}}
                        {{#is name "Case studies"}}
                        {{else}}
